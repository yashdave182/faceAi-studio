# Copy this file to .env and fill in the keys you want to use.

# --- Providers ---

# fal.ai key (primary provider: identity-guided FLUX PuLID).
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# Gemini API key (optional, used by the gemini fallback provider).
# Note: Gemini image models currently require a paid plan/billing.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Model chain ---
# Ordered, comma-separated, "provider:model". The first entry is the primary
# model; the rest are fallbacks tried in order. Providers: fal | gemini.
IMAGE_MODEL_PRIMARY=fal:fal-ai/flux-pulid
IMAGE_MODEL_FALLBACK=gemini:gemini-nano-banana-2.1

# Optional tuning
# FAL_ID_WEIGHT=1.0          # Max 1.0 (strict face identity weight)
# FAL_INFERENCE_STEPS=28     # 20-35 (higher = richer details & skin texture)
# FAL_GUIDANCE_SCALE=4.0     # Prompt guidance weight
# FAL_ENABLE_ENHANCE=true    # Optional 2nd stage face enhancement
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_API=classic   # classic | interactions | auto
